{
  "name": "modelrc",
  "description": "按当前会话模型向 agent 注入提示词。规则与提示词放在用户配置目录，不随插件分发。",
  "version": "0.1.1",
  "author": {
    "name": "xiaoshao9704"
  },
  "license": "MIT",
  "keywords": [
    "hooks",
    "prompt",
    "model",
    "routing"
  ],
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/modelrc\" hook"
          }
        ]
      }
    ]
  }
}
