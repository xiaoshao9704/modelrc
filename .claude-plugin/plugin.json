{
  "name": "modelrc",
  "description": "按当前会话模型向 agent 动态注入提示词（支持 Claude Code、Codex、Antigravity）。规则与提示词放在用户配置目录，不随插件分发。",
  "version": "0.3.0",
  "author": {
    "name": "xiaoshao9704"
  },
  "license": "MIT",
  "keywords": [
    "hooks",
    "prompt",
    "model",
    "routing"
  ],
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/modelrc\" hook --harness claude"
          }
        ]
      }
    ]
  },
  "skills": "./skills/"
}
